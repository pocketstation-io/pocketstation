  "responsibilities": [
    "pocketstation::connector::status::ConnectorDeliveryReadiness: Enumerates the supported connector delivery readiness cases.",
    "pocketstation::connector::status::ConnectorDeliveryReadiness::NotReady: Identifies the not ready state or stage represented by `ConnectorDeliveryReadiness`.",
    "pocketstation::connector::status::ConnectorDeliveryReadiness::Ready: Identifies the ready state or stage represented by `ConnectorDeliveryReadiness`.",
    "accepts_delivery: Returns whether accepts delivery applies to `ConnectorDeliveryReadiness`.",
    "pocketstation::connector::status::ConnectorHealth: Enumerates the supported connector health cases.",
    "pocketstation::connector::status::ConnectorHealth::Healthy: Represents the healthy alternative defined by `ConnectorHealth`.",
    "pocketstation::connector::status::ConnectorHealth::Degraded: Represents the degraded alternative defined by `ConnectorHealth`.",
    "pocketstation::connector::status::ConnectorRecovery: Enumerates the supported connector recovery cases.",
    "pocketstation::connector::status::ConnectorRecovery::Idle: Represents the idle alternative defined by `ConnectorRecovery`.",
    "pocketstation::connector::status::ConnectorRecovery::Reconnecting: Represents the reconnecting alternative defined by `ConnectorRecovery`.",
    "pocketstation::connector::status::ConnectorServiceStatus: Reports the structured connector service status.",
    "delivery_readiness: Returns the delivery readiness associated with `ConnectorServiceStatus`.",
    "health: Returns the health held by `ConnectorServiceStatus`.",
    "recovery: Returns the recovery held by `ConnectorServiceStatus`.",
    "readiness_reason_code: Returns the readiness reason code held by `ConnectorServiceStatus`.",
    "health_reason_code: Returns the health reason code held by `ConnectorServiceStatus`.",
    "recovery_reason_code: Returns the recovery reason code held by `ConnectorServiceStatus`.",
    "revision: Returns the revision held by `ConnectorServiceStatus`.",
    "last_transition_elapsed_ns: Returns the last transition elapsed nanoseconds held by `ConnectorServiceStatus`.",
    "accepts_delivery: Returns whether accepts delivery applies to `ConnectorServiceStatus`."
  ],
