  "purpose": {
    "classification": "DECLARED",
    "text": "Reports the clock drift snapshot collected at an observation boundary. Reports the estimated clock drift for `ClockDriftSnapshot`, in parts per million. Stores the accumulated error value for `ClockDriftSnapshot`, in nanoseconds."
  },
