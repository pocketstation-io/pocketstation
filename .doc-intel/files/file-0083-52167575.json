  "responsibilities": [
    "pocketstation::capture::observations::CaptureObservations: Reports the capture observations collected at an observation boundary.",
    "CaptureObservations::callback_buffers_total: Counts the total number of callback buffers observed by `CaptureObservations`.",
    "CaptureObservations::frames_enqueued_total: Counts the total number of frames enqueued observed by `CaptureObservations`.",
    "CaptureObservations::pool_exhausted_total: Counts the total number of pool exhausted observed by `CaptureObservations`.",
    "CaptureObservations::dispatch_queue_full_total: Counts the total number of dispatch queue full observed by `CaptureObservations`.",
    "CaptureObservations::invalid_buffer_total: Counts the total number of invalid buffer observed by `CaptureObservations`.",
    "CaptureObservations::oversized_buffer_total: Counts the total number of oversized buffer observed by `CaptureObservations`.",
    "CaptureObservations::stream_errors_total: Counts the total number of stream errors observed by `CaptureObservations`.",
    "CaptureObservations::timestamp_epoch_clamps_total: Counts the total number of timestamp epoch clamps observed by `CaptureObservations`.",
    "pocketstation::capture::observations::CaptureObservationHandle: Holds the ownership or bounded access represented by capture observation handle.",
    "observations: Returns the observations exposed by `CaptureObservationHandle`.",
    "pocketstation::capture::observations::CaptureObservationCounters: Setup-time cloneable handle; every observation is one relaxed atomic",
    "observe_callback_buffer: Records an observation for callback buffer for `CaptureObservationCounters`.",
    "observe_enqueued_frame: Records an observation for enqueued frame for `CaptureObservationCounters`.",
    "observe_pool_exhaustion: Records an observation for pool exhaustion for `CaptureObservationCounters`.",
    "observe_dispatch_queue_full: Records an observation for dispatch queue full for `CaptureObservationCounters`.",
    "observe_dispatch_queue_full_frames: Records a known number of frames lost at a bounded native or Rust",
    "observe_oversized_buffer: Records an observation for oversized buffer for `CaptureObservationCounters`.",
    "observe_stream_error: Records an observation for stream error for `CaptureObservationCounters`.",
    "observe_timestamp_epoch_clamp: Records an observation for timestamp epoch clamp for `CaptureObservationCounters`.",
    "observation_handle: Returns a handle for reading observations from `CaptureObservationCounters`.",
    "snapshot: Returns a point-in-time snapshot of `CaptureObservationCounters`."
  ],
