  "responsibilities": [
    "pocketstation::graph::signal::continuity::SignalContinuityObservation: Reports sequence or timestamp continuity observed for one signal stream.",
    "SignalContinuityObservation::discontinuity_observed: Reports whether discontinuity is observed for `SignalContinuityObservation`.",
    "SignalContinuityObservation::source_recovered: References the source recovered participating in `SignalContinuityObservation`.",
    "SignalContinuityObservation::policy_changed: Reports whether policy changed is true for `SignalContinuityObservation`.",
    "pocketstation::graph::signal::continuity::SignalContinuityTracker: Tracks sequence and timing progress so discontinuities remain observable.",
    "observe: Returns the current observation exposed by `SignalContinuityTracker`.",
    "pocketstation::graph::signal::continuity::SignalContinuityError: Classifies failures surfaced by signal continuity operations.",
    "pocketstation::graph::signal::continuity::SignalContinuityError::InvalidEnvelope: Reports that the supplied envelope is invalid.",
    "pocketstation::graph::signal::continuity::SignalContinuityError::MissingLineage: Reports that the required lineage is missing.",
    "pocketstation::graph::signal::continuity::SignalContinuityError::IdentityChanged: Reports that identity changed across a boundary that requires stability.",
    "pocketstation::graph::signal::continuity::SignalContinuityError::SequenceGapWithoutDiscontinuity: Classifies a failure at the sequence gap without discontinuity stage or component of `SignalContinuityError`.",
    "pocketstation::graph::signal::continuity::SignalContinuityError::TimestampRegression: Reports that timestamp moved backward instead of remaining monotonic.",
    "pocketstation::graph::signal::continuity::SignalContinuityError::DiscontinuityRegressed: Reports that discontinuity moved backward instead of remaining monotonic.",
    "pocketstation::graph::signal::continuity::SignalContinuityError::GenerationRegressed: Reports that generation moved backward instead of remaining monotonic.",
    "pocketstation::graph::signal::continuity::SignalContinuityError::RecoveryWithoutDiscontinuity: Classifies a failure at the recovery without discontinuity stage or component of `SignalContinuityError`.",
    "pocketstation::graph::signal::continuity::SignalContinuityError::PolicyRegressed: Reports that policy moved backward instead of remaining monotonic."
  ],
