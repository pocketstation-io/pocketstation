  "responsibilities": [
    "pocketstation::timing::clock_drift::ClockDriftSnapshot: Reports the clock drift snapshot collected at an observation boundary.",
    "ClockDriftSnapshot::drift_ppm: Stores the drift ppm used by `ClockDriftSnapshot`.",
    "ClockDriftSnapshot::accumulated_error_ns: Stores the accumulated error value for `ClockDriftSnapshot`, in nanoseconds.",
    "ClockDriftSnapshot::observed_samples_count: Stores the number of observed samples represented by `ClockDriftSnapshot`.",
    "pocketstation::timing::clock_drift::ClockDriftEstimator: Estimates source-clock drift from accumulated source and Session timing observations.",
    "new: Creates a new `ClockDriftEstimator`.",
    "observe: Returns the current observation exposed by `ClockDriftEstimator`.",
    "drift_ppm: Returns the drift ppm associated with `ClockDriftEstimator`.",
    "accumulated_error_ns: Returns the accumulated error nanoseconds held by `ClockDriftEstimator`.",
    "snapshot: Returns a point-in-time snapshot of `ClockDriftEstimator`.",
    "default: Returns the default `ClockDriftEstimator` value."
  ],
